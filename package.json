{
  "name": "@yandu/plugin-search-arxiv",
  "version": "1.0.0",
  "description": "Yandu arXiv search plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepack": "npm run test"
  },
  "dependencies": {
    "@yandu/types": "0.0.7",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "yandu-search-arxiv": "./dist/worker.js"
  },
  "yandu": {
    "worker": "./dist/worker.js",
    "protocol": "jsonl-v1"
  }
}
